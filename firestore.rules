rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 0. Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // Helpers
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function isVerified() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    // 1. Users Collection
    match /users/{userId} {
      function isValidUser(data) {
        return data.keys().hasAll(['email', 'createdAt']) 
               && data.keys().size() <= 4
               && data.email is string && data.email.size() <= 256
               && data.createdAt == request.time;
      }

      allow get: if isOwner(userId);
      allow create: if isOwner(userId) && isValidUser(incoming());
      allow update: if isOwner(userId) && isVerified() && isValidUser(incoming()) 
                     && incoming().diff(resource.data).affectedKeys().hasOnly(['displayName']);
    }

    // 2. Messages Collection (Contact Form)
    match /messages/{messageId} {
      function isValidId(id) {
         return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
      }
      
      function isValidMessage(data) {
        return data.keys().hasAll(['name', 'email', 'message', 'createdAt'])
               && data.keys().size() == 4
               && data.name is string && data.name.size() <= 100
               && data.email is string && data.email.size() <= 256
               && data.message is string && data.message.size() <= 5000
               && data.createdAt == request.time;
      }

      allow create: if isValidId(messageId) && isValidMessage(incoming());
      // No read/update/delete for public or even registered users to protect PII
    }
  }
}
